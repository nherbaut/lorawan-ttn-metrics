        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sort_desc(sum by (frequency_mhz) (increase(ttn_gateway_uplinks_total{gateway_id=~\"$gateway\"}[$__range])))",
          "legendFormat": "{{frequency_mhz}} MHz",
          "refId": "A",
          "range": false,
