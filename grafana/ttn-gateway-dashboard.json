        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (le) (increase(ttn_gateway_uplink_snr_db_bucket{gateway_id=~\"$gateway\"}[$__rate_interval]))",
